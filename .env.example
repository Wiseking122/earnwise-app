# Paystack API Keys
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# App URL (for Telegram Bot)
APP_URL=https://...

# EmailJS Config
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Email Sending (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Render SMTP Configuration (Modern Nodemailer Setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Earnwise Info" <your-email@gmail.com>

# CPX Research Configuration
CPX_APP_ID=33341
CPX_SECURE_HASH=your_cpx_secure_hash_here

# BitcoTasks Offerwall
BITCOTASKS_SECRET_KEY=

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OGAds API Settings
OGADS_API_KEY=your_ogads_api_key_here

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=

# API Configuration (For Vercel/Render connection)
# On Vercel, set VITE_API_URL to your Render backend URL (e.g., https://earnwise-c30u.onrender.com)
VITE_API_URL=
# On Vercel, set VITE_WS_URL to your Render backend WebSocket URL (e.g., wss://earnwise-c30u.onrender.com)
VITE_WS_URL=

# CPAgrip Config
CPAGRIP_USER_ID=
CPAGRIP_PUBKEY=
CPAGRIP_PRIVATE_KEY=
