# Paystack API Keys
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# App URL (for Telegram Bot)
APP_URL=https://...

# EmailJS Config
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Email Sending (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# CPX Research Webhook Secure Hash
CPX_SECURE_HASH=your_cpx_secure_hash_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=

# API Configuration (For Vercel/Render connection)
# On Vercel, set VITE_API_URL to your Render backend URL (e.g., https://earnwise-o30u.onrender.com)
VITE_API_URL=
# On Vercel, set VITE_WS_URL to your Render backend WebSocket URL (e.g., wss://earnwise-o30u.onrender.com)
VITE_WS_URL=
