rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasActivePlan(userId) {
      return isAdmin() || (exists(/databases/$(database)/documents/users/$(userId)) && 
                          getUserData(userId).plan != null && 
                          getUserData(userId).plan != 'none');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.uid == 'Ik1Ngp1oC9hYXZt9lQEPIeOiCGA3') ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 
         request.auth.token.email.matches('(?i)^wiseking7890@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validators ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin', 'advertiser'] &&
             data.pendingBalance is number &&
             data.withdrawableBalance is number &&
             data.referralCode is string &&
             data.taskBalance is number &&
             data.referralBalance is number &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.type in ['survey', 'ad', 'app_download', 'referral', 'content_creation'] &&
             data.reward is number && data.reward >= 0 &&
             data.status in ['active', 'inactive'];
    }

    function isValidCompletion(data) {
      return data.userId == request.auth.uid &&
             data.taskId is string &&
             (data.status == 'pending' || (data.status == 'approved' && (data.isAdNetwork == true || data.isSpin == true))) &&
             data.rewardEarned is number &&
             (data.submittedAt == request.time || data.submittedAt is timestamp);
    }

    function getMinWithdrawal(plan) {
      return plan == 'elite' ? 3000 :
             plan == 'starter' ? 6000 :
             plan == 'pro' ? 9000 :
             plan == 'bronze' ? 15000 :
             plan == 'diamond' ? 21000 :
             plan == 'silver' ? 30000 :
             plan == 'platinum' ? 45000 :
             plan == 'golden' ? 75000 : 1000;
    }

    function isValidWithdrawal(data) {
      return data.userId == request.auth.uid &&
             data.amount is number && data.amount >= getMinWithdrawal(getUserData(request.auth.uid).plan) &&
             data.status == 'pending' &&
             data.bankDetails.accountNumber is string;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             (data.userId is string) &&
             data.priority in ['low', 'normal', 'high'] &&
             data.category in ['system', 'reward', 'withdrawal', 'promo', 'security', 'task'] &&
             data.status in ['pending', 'sent', 'failed', 'scheduled'] &&
             data.createdAt is timestamp;
    }

    function isValidDeviceToken(data) {
      return data.token is string && data.token.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.createdAt is timestamp &&
             data.lastUsedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.shortMessage is string && data.shortMessage.size() <= 500 &&
             data.priority is number &&
             data.category is string &&
             data.placements is list &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.isActive is bool &&
             data.status in ['draft', 'published', 'scheduled', 'archived'];
    }

    function isValidCoursePurchase(data) {
      return data.userId == request.auth.uid &&
             data.courseId is string &&
             (data.amount == 7000 || data.amount == 0) &&
             (data.purchasedAt == request.time || data.purchasedAt is timestamp);
    }

    function isValidVaultEntry(data) {
      return data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 &&
             data.bonus is number && data.bonus >= 0 &&
             data.payoutAmount is number && data.payoutAmount > 0 &&
             data.status in ['locked', 'unlocked'] &&
             (data.lockedAt == request.time || data.lockedAt is timestamp) &&
             (data.unlocksAt is timestamp || data.unlocksAt is string);
    }

    function isValidAppeal(data) {
      return data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.username is string && data.username.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 3000 &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if true; // Allow lookup by username/email for login/signup
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && 
         'email' in request.auth.token && 
         request.auth.token.email.matches('(?i)^wiseking7890@gmail\\.com$') &&
         incoming().role == 'admin') ||
        (request.auth.uid == userId && (
          !incoming().diff(existing()).affectedKeys().hasAny(['role'])
        )) ||
        (set(['balance', 'referralBalance', 'withdrawableBalance', 'referralEarnings', 'hasReceivedReferralBonus', 'totalReferrals', 'updatedAt', 'fcmTokens', 'pushEnabled', 'lastCoachingAt', 'coachingStep', 'wiseCoins', 'completedAds', 'xp', 'lastCheckIn', 'streak']).hasAll(incoming().diff(existing()).affectedKeys()))
      );
    }

    match /device_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidDeviceToken(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidDeviceToken(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /wise_coin_wallets/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (userId == request.auth.uid || isAdmin());
    }

    match /survey_submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /offer_submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /wise_coin_transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /coin_conversions/{conversionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcement_analytics/{announcementId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if true; // Tasks are public job listings
      allow write: if isAdmin() || (isSignedIn() && (
        (resource == null && request.resource.data.advertiserId == request.auth.uid) ||
        (resource != null && resource.data.advertiserId == request.auth.uid)
      ));
    }

    match /completions/{completionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isSpin == true || resource.data.isAdNetwork == true));
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && isValidWithdrawal(incoming()) && isValidId(withdrawalId);
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid));
      allow create: if isAdmin() || (isSignedIn() && (incoming().userId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userId == 'all' || 
        resource.data.userId == 'premium' || 
        resource.data.userId == 'free' || 
        resource.data.userId == 'new' ||
        isAdmin()
      );
      allow create: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && set(['read', 'isRead']).hasAll(incoming().diff(existing()).affectedKeys())) ||
        (resource.data.userId in ['all', 'premium', 'free', 'new'] && set(['readBy']).hasAll(incoming().diff(existing()).affectedKeys()))
      );
    }

    match /coursePurchases/{purchaseId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidCoursePurchase(incoming()) && isValidId(purchaseId);
      allow update, delete: if isAdmin();
    }

    match /vault_entries/{vaultEntryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidVaultEntry(incoming()) && isValidId(vaultEntryId) &&
                      getUserData(request.auth.uid).withdrawableBalance >= incoming().amount;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidVaultEntry(incoming()) && (
                      set(['status', 'claimedAt']).hasAll(incoming().diff(existing()).affectedKeys()) &&
                      existing().status == 'locked' &&
                      incoming().status == 'unlocked' &&
                      incoming().claimedAt == request.time
                    );
      allow delete: if false;
    }

    match /course_overrides/{courseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == 'Ik1Ngp1oC9hYXZt9lQEPIeOiCGA3' || isAdmin());
    }

    match /system_settings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['views', 'clicks', 'watchTime']))
      );
      allow create, delete: if isAdmin();
    }

    match /appeals/{appealId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidAppeal(incoming()) && isValidId(appealId);
      allow update, delete: if isAdmin();
    }

    // Default Deny at the bottom
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
