{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with behavioral tracking and tiered balances",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "advertiser"] },
        "pendingBalance": { "type": "number", "description": "Funds awaiting cooldown/verification" },
        "withdrawableBalance": { "type": "number", "description": "Cleared funds available for withdrawal" },
        "depositBalance": { "type": "number", "description": "Funds deposited directly from personal banks" },
        "behavioralTags": { "type": "array", "items": { "type": "string" }, "description": "Interests like tech, finance, etc." },
        "demographics": {
          "type": "object",
          "properties": {
            "deviceType": { "type": "string" },
            "location": { "type": "string" },
            "age": { "type": "number" }
          }
        },
        "securityMetrics": {
          "type": "object",
          "properties": {
            "lastIp": { "type": "string" },
            "deviceFingerprint": { "type": "string" },
            "isSuspended": { "type": "boolean" },
            "suspensionReason": { "type": "string" }
          }
        },
        "referralCode": { "type": "string" }
      },
      "required": ["uid", "email", "role", "pendingBalance", "withdrawableBalance"]
    },
    "Task": {
      "title": "Task",
      "description": "B2B Advertiser-defined tasks with budget tracking",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "advertiserId": { "type": "string" },
        "title": { "type": "string" },
        "totalBudget": { "type": "number" },
        "remainingBudget": { "type": "number" },
        "userPayout": { "type": "number", "description": "Reward after platform split" },
        "platformMargin": { "type": "number", "description": "Calculated 30% margin" },
        "targetDemographics": { "type": "array", "items": { "type": "string" } },
        "tag": { "type": "string", "description": "Label for user behavioral tracking" },
        "link": { "type": "string", "description": "Affiliate or external link" },
        "videoUrl": { "type": "string", "description": "Direct video link or embed" },
        "imageUrl": { "type": "string", "description": "Rich media image URL" },
        "shareText": { "type": "string", "description": "Pre-filled text for social media sharing" },
        "enableSocialShare": { "type": "boolean", "description": "Whether to show social share buttons" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] }
      },
      "required": ["advertiserId", "totalBudget", "userPayout", "status"]
    },
    "TaskCompletion": {
      "title": "Task Completion",
      "description": "Record of a user completing a task",
      "type": "object",
      "properties": {
        "completionId": { "type": "string" },
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rewardEarned": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string" }
      },
      "required": ["userId", "taskId", "status", "rewardEarned", "submittedAt"]
    },
    "WithdrawalRequest": {
      "title": "Withdrawal Request",
      "description": "User request to withdraw earnings via bank transfer",
      "type": "object",
      "properties": {
        "withdrawalId": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "completed", "rejected"] },
        "bankDetails": {
          "type": "object",
          "properties": {
            "accountName": { "type": "string" },
            "bankName": { "type": "string" },
            "accountNumber": { "type": "string" }
          }
        },
        "requestedAt": { "type": "string", "format": "date-time" },
        "processedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "status", "bankDetails", "requestedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction ledger entry",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["earning", "withdrawal", "referral"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or admin-sent notification to users",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string", "description": "Specific user, or 'all', 'premium', 'free', 'new'" },
        "targetPlanIds": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "message": { "type": "string" },
        "image": { "type": "string" },
        "icon": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonUrl": { "type": "string" },
        "deepLink": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "normal", "high"] },
        "category": { "type": "string", "enum": ["system", "reward", "withdrawal", "promo", "security", "task"] },
        "status": { "type": "string", "enum": ["pending", "sent", "failed", "scheduled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "isRead": { "type": "boolean" }
      },
      "required": ["title", "message", "createdAt", "priority", "category", "status"]
    },
    "DeviceToken": {
      "title": "Device Token",
      "description": "FCM tokens for push notifications",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "deviceType": { "type": "string" },
        "browser": { "type": "string" },
        "platform": { "type": "string", "enum": ["web", "android", "ios", "telegram"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "userId", "createdAt", "lastUsedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Dynamic banners and popups",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortMessage": { "type": "string" },
        "fullDescription": { "type": "string" },
        "bannerImage": { "type": "string" },
        "icon": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonLink": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "textColor": { "type": "string" },
        "priority": { "type": "number" },
        "category": { "type": "string" },
        "placements": { "type": "array", "items": { "type": "string" } },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "scheduled", "archived"] },
        "targetAudience": { "type": "string" },
        "displayFrequency": { "type": "string" },
        "manualClose": { "type": "boolean" },
        "stickyUntilClosed": { "type": "boolean" },
        "requireAcknowledgement": { "type": "boolean" },
        "animationType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "shortMessage", "priority", "category", "placements", "startDate", "endDate", "isActive", "status"]
    },
    "AnnouncementAnalytics": {
      "title": "Announcement Analytics",
      "description": "Tracking for announcements",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string" },
        "totalViews": { "type": "number" },
        "totalClicks": { "type": "number" },
        "totalDismissals": { "type": "number" },
        "totalAcknowledgements": { "type": "number" }
      }
    },
    "CoursePurchase": {
      "title": "Course Purchase",
      "description": "Record of a user buying an academy course",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "amount": { "type": "number" },
        "purchasedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "amount", "purchasedAt"]
    },
    "VaultEntry": {
      "title": "Vault Entry",
      "description": "Stake/fixed-term locking of user funds in the Vault",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "bonus": { "type": "number" },
        "payoutAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["locked", "unlocked"] },
        "lockedAt": { "type": "string", "format": "date-time" },
        "unlocksAt": { "type": "string", "format": "date-time" },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "bonus", "payoutAmount", "status", "lockedAt", "unlocksAt"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration and toggles",
      "type": "object",
      "properties": {
        "adsMaintenanceMode": { "type": "boolean", "description": "Global lock for the Ads Center" },
        "maintenanceMessage": { "type": "string", "description": "Message to show when Ads Center is locked" },
        "payoutEnabled": { "type": "boolean", "description": "Global toggle for withdrawals" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global configuration settings"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks created by admins"
    },
    "/completions/{completionId}": {
      "schema": "TaskCompletion",
      "description": "User submissions for tasks"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "WithdrawalRequest",
      "description": "Money withdrawal requests"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transaction logs for balance history"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System notifications"
    },
    "/device_tokens/{tokenId}": {
      "schema": "DeviceToken",
      "description": "FCM device tokens"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "System announcements"
    },
    "/announcement_analytics/{announcementId}": {
      "schema": "AnnouncementAnalytics",
      "description": "Analytics for announcements"
    },
    "/coursePurchases/{purchaseId}": {
      "schema": "CoursePurchase",
      "description": "Academy course purchases"
    },
    "/vault_entries/{vaultEntryId}": {
      "schema": "VaultEntry",
      "description": "Vault staking entries"
    },
    "/wise_coin_wallets/{userId}": {
      "schema": "WiseCoinWallet",
      "description": "Wise Coin user balances"
    },
    "/survey_submissions/{submissionId}": {
      "schema": "SurveySubmission",
      "description": "User survey proof submissions"
    },
    "/wise_coin_transactions/{transactionId}": {
      "schema": "WiseCoinTransaction",
      "description": "Wise Coin transaction logs"
    },
    "/coin_conversions/{conversionId}": {
      "schema": "CoinConversion",
      "description": "Logs for WC to Naira conversions"
    }
  },
  "indexes": [
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "collectionGroup": "announcements",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "isActive",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "placements",
          "arrayConfig": "CONTAINS"
        }
      ]
    },
    {
      "collectionGroup": "survey_submissions",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "submittedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "collectionGroup": "survey_submissions",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "submittedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "collectionGroup": "survey_submissions",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "wise_coin_transactions",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    }
  ]
}
